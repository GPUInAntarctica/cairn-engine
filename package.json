{
  "name": "cairn-engine",
  "productName": "Cairn Engine",
  "version": "0.1.31",
  "description": "A compact C++ game engine with a focused editor for 2D and 3D projects.",
  "license": "MIT",
  "author": "Cairn Engine Contributors",
  "homepage": "https://github.com/cairn-engine/cairn-engine#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cairn-engine/cairn-engine.git"
  },
  "keywords": [
    "game-engine",
    "cpp",
    "2d",
    "3d",
    "editor",
    "electron"
  ],
  "main": "editor/main/main.js",
  "bin": {
    "cairn": "cli/index.js"
  },
  "files": [
    "cli",
    "editor",
    "engine",
    "runtime",
    "templates",
    "scripts"
  ],
  "scripts": {
    "build:engine": "node scripts/build.js engine",
    "build:addon": "node scripts/build.js addon",
    "build": "node scripts/build.js",
    "test:engine": "node scripts/run-engine-tests.js",
    "rebuild": "node scripts/build.js --force",
    "prestart": "node scripts/build.js renderer",
    "test": "npm run test:engine && node test/build.js && node test/smoke.js && node test/cli.js",
    "docs:cli": "node scripts/gen-cli-docs.js",
    "cairn": "node cli/index.js",
    "start": "electron .",
    "dev": "electron . --dev"
  },
  "dependencies": {
    "monaco-editor": "^0.52.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "esbuild": "^0.28.2",
    "node-addon-api": "^8.3.0"
  }
}
